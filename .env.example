APP_NAME="Eloom LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

# Copyright footer shown on every dashboard
APP_FOOTER_TEXT="${APP_NAME}"
APP_FOOTER_URL="${APP_URL}"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Maximum number of students that can be created (default 100)
STUDENT_COUNT=100

# Firebase Cloud Messaging (browser push notifications) - optional
# Web app config from Firebase console > Project settings > General
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Firebase console > Project settings > Cloud Messaging > Web Push certificates
FIREBASE_VAPID_KEY=
# Legacy FCM server key, used when no key is saved in the notification settings
SERVER_API_KEY=

# Socket.io server for real-time chat - optional
SOCKET_SERVER_URL=http://127.0.0.1:3000
MIX_SOCKET_SERVER_URL="${SOCKET_SERVER_URL}"

# DOCX-to-HTML conversion service used by the certificate template importer - optional
# Must accept POST {DOCX_CONVERTER_URL}/convert with multipart "files" + "conversion_type=docx_to_html"
DOCX_CONVERTER_URL=

# Zoom (online classes) - optional
ZOOM_API_URL=
ZOOM_API_KEY=
ZOOM_API_SECRET=
ZOOM_API_JWT=
